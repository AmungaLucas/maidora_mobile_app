{
  "expo": {
    "name": "Maidora",
    "slug": "maidora",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maidora.app"
    },
    "android": {
      "package": "com.maidora.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#174B3A"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Maidora uses your location to prefill your marketplace area and show nearby jobs and domestic workers."
        }
      ]
    ]
  }
}